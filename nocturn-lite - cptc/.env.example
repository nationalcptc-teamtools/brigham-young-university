# Copy to `.env` and fill in. The binary loads `.env` (next to the binary, then
# the working directory) at startup; real deployments should prefer real
# environment variables and ship NO .env file. Never commit a real .env.

# ── Licensing / monetization mode ────────────────────────────────────────────
# local    (default) self-hosted: every signed-in user gets full Pro access.
# free     force the locked baseline — useful for testing the paywall UI.
# supabase enforce subscriptions stored in Supabase (hosted-SaaS model).
LICENSE_MODE=local

# Set to 1 to unlock everything regardless of LICENSE_MODE (local dev only).
# DEV_UNLOCK=1

# ── Supabase (only needed when LICENSE_MODE=supabase) ─────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key — SERVER-SIDE ONLY. Never expose this to the browser; it
# bypasses row-level security. (The browser, when you add Supabase Auth, uses
# the separate anon/public key instead.)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: table the entitlement lookup reads. Defaults to "subscriptions".
# Assumed columns: user_key (text), plan (text), status (text), expires_at (timestamptz).
# SUPABASE_SUBSCRIPTIONS_TABLE=subscriptions
